@model List<ARM.Integration.Dashboard.Web.Models.AppUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">👥 User Management</h4>
    <a asp-action="Create" class="btn btn-success btn-sm">+ Add User</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Display Name</th>
                <th>Role</th>
                <th>Active</th>
                <th>Created</th>
                <th style="width:130px"></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No users configured.</td>
                </tr>
            }
            @foreach (var user in Model)
            {
                <tr>
                    <td><code>@user.Email</code></td>
                    <td>@user.DisplayName</td>
                    <td><span class="@user.RoleBadgeClass">@user.Role</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td><small class="text-muted">@user.CreatedDateTime?.ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-email="@user.Email"
                           class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Remove @user.Email?');">
                            <input type="hidden" name="email" value="@user.Email" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<small class="text-muted">@Model.Count user(s)</small>
