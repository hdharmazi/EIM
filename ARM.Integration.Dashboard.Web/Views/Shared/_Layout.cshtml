@{
    var ctrl    = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var qStatus = Context.Request.Query["status"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EIM Dashboard</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ARM.Integration.Dashboard.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ░░ Sidebar ░░ -->
    <aside id="sidebar" class="sidebar">

        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="sidebar-brand-icon">⚡</span>
            <span class="sidebar-brand-text">EIM Dashboard</span>
        </a>

        <nav class="sidebar-nav-wrapper">
            <ul class="sidebar-nav">

                <!-- Overview -->
                <li class="nav-section">Overview</li>
                <li>
                    <a class="sidebar-link @(ctrl == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <span class="nav-icon">🏠</span>
                        <span class="nav-label">Dashboard</span>
                    </a>
                </li>

                <!-- Messages -->
                <li class="nav-section">Messages</li>
                <li>
                    <a class="sidebar-link @(ctrl == "MessageQueue" && string.IsNullOrEmpty(qStatus) && act == "Index" ? "active" : "")"
                       asp-controller="MessageQueue" asp-action="Index">
                        <span class="nav-icon">📨</span>
                        <span class="nav-label">All Messages</span>
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(ctrl == "MessageQueue" && qStatus == "3" ? "active" : "")"
                       asp-controller="MessageQueue" asp-action="Index" asp-route-status="3">
                        <span class="nav-icon">⚠️</span>
                        <span class="nav-label">Failed</span>
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(ctrl == "MessageQueue" && qStatus == "4" ? "active" : "")"
                       asp-controller="MessageQueue" asp-action="Index" asp-route-status="4">
                        <span class="nav-icon">💀</span>
                        <span class="nav-label">Dead</span>
                    </a>
                </li>

                <!-- Utilities -->
                <li class="nav-section">Utilities</li>
                <li>
                    <a class="sidebar-link @(ctrl == "MessageQueue" && act == "Cleanup" ? "active" : "")"
                       asp-controller="MessageQueue" asp-action="Cleanup">
                        <span class="nav-icon">🧹</span>
                        <span class="nav-label">Cleanup Queue</span>
                    </a>
                </li>

                <!-- Configuration -->
                <li class="nav-section">Configuration</li>
                <li>
                    <a class="sidebar-link @(ctrl == "Environment" ? "active" : "")"
                       asp-controller="Environment" asp-action="Index">
                        <span class="nav-icon">⚙️</span>
                        <span class="nav-label">Environments</span>
                    </a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <!-- Administration -->
                    <li class="nav-section">Administration</li>
                    <li>
                        <a class="sidebar-link @(ctrl == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <span class="nav-icon">👥</span>
                            <span class="nav-label">Users</span>
                        </a>
                    </li>
                }

            </ul>
        </nav>

        <div class="sidebar-footer">
            <small>ARM Integration EIM</small>
        </div>
    </aside>

    <!-- ░░ Mobile overlay ░░ -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- ░░ Main wrapper ░░ -->
    <div class="main-wrapper">

        <!-- Top bar -->
        <header class="topbar">
            <button id="sidebarToggle" class="sidebar-toggle" title="Toggle sidebar">
                <span>&#9776;</span>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>
            <div class="ms-auto d-flex align-items-center gap-2 me-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted small">@User.Identity.Name</span>
                    <a href="/MicrosoftIdentity/Account/SignOut" class="btn btn-outline-secondary btn-sm">Sign out</a>
                }
            </div>
        </header>

        <!-- Page content -->
        <main class="content-area" role="main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <small>&copy; @DateTime.Now.Year — ARM Integration EIM</small>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
