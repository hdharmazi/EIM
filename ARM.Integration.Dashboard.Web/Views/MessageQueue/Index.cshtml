@model ARM.Integration.Dashboard.Web.Models.MessageQueueViewModel
@{
    ViewData["Title"] = "Message Queue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Message Queue</h4>
    <small class="text-muted">Showing @Model.TotalCount records</small>
</div>

<!-- Filter bar -->
<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            @foreach (var (val, label) in new[] { ("0","NEW"), ("1","PROCESSING"), ("2","COMPLETED"), ("3","FAILED"), ("4","DEAD"), ("5","AWAITING D365") })
            {
                <option value="@val" selected="@(Model.StatusFilter?.ToString() == val)">@label</option>
            }
        </select>
    </div>
    <div class="col">
        <input name="search" type="text" class="form-control form-control-sm"
               placeholder="Search source ID, type, system…" value="@Model.SearchTerm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">Clear</a>
    </div>
</form>

<!-- Grid -->
<div class="table-responsive">
    <table class="table table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th style="min-width: 250px;">Type</th>
                <th>Source System</th>
                <th>Destination System</th>
                <th>Source ID</th>
                <th>Environment</th>
                <th style="min-width: 300px;">Payload</th>
                <th>Status</th>
                <th>Modified</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Messages.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">No messages found.</td>
                </tr>
            }
            @foreach (var msg in Model.Messages)
            {
                <tr class="@(msg.HasError ? "table-danger" : string.Empty)">
                    <td>@msg.Id</td>
                    <td><small>@msg.Type</small></td>
                    <td>@msg.SourceSystem</td>
                    <td>@msg.DestinationSystem</td>
                    <td><small class="text-muted">@msg.SourceId</small></td>
                    <td><small>@msg.Environment</small></td>
                    <td>
                        <small class="text-muted text-break" style="max-width: 300px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;"
                               title="@msg.Payload"
                               onclick="this.style.whiteSpace = this.style.whiteSpace === 'normal' ? 'nowrap' : 'normal'">
                            @msg.Payload
                        </small>
                    </td>
                    <td><span class="@msg.StatusBadgeClass">@msg.StatusLabel</span></td>
                    <td><small class="text-muted">@msg.ModifiedDateTime?.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@msg.Id"
                           class="btn btn-sm btn-outline-secondary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
