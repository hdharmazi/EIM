@{
    ViewData["Title"] = "Cleanup Message Queue";
    var statusCounts = ViewData["StatusCounts"] as Dictionary<int, int> ?? new();
    var statusLabels = new Dictionary<int, string>
    {
        [0] = "NEW",
        [1] = "PROCESSING",
        [2] = "COMPLETED",
        [3] = "FAILED",
        [4] = "DEAD"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">🧹 Cleanup Message Queue</h4>
</div>

@if (TempData["CleanupMessage"] is string msg)
{
    var success = TempData["CleanupSuccess"] is true;
    <div class="alert @(success ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Current counts -->
<div class="card mb-4">
    <div class="card-header">Current Record Counts by Status</div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var (val, label) in statusLabels)
            {
                var count = statusCounts.TryGetValue(val, out var c) ? c : 0;
                <div class="col-auto">
                    <span class="badge bg-secondary fs-6">@label: @count</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Cleanup form -->
<div class="card">
    <div class="card-header">Delete Records</div>
    <div class="card-body">
        <form method="post" asp-action="CleanupConfirm" id="cleanupForm">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Status Filter</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var (val, label) in statusLabels)
                        {
                            <option value="@val">@label</option>
                        }
                    </select>
                    <small class="text-muted">Leave empty to target all statuses.</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Older Than (days)</label>
                    <input name="olderThanDays" type="number" class="form-control" min="1" placeholder="e.g. 30" />
                    <small class="text-muted">Leave empty to ignore age.</small>
                </div>
            </div>
            <div class="alert alert-warning">
                <strong>⚠️ Warning:</strong> This will permanently delete matching records and their log details. This action cannot be undone. At least one filter is required.
            </div>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmModal">
                Delete Records
            </button>
        </form>
    </div>
</div>

<!-- Confirmation modal -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Cleanup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete matching records? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('cleanupForm').submit();">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>
