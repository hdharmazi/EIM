@model ARM.Integration.Dashboard.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "EIM Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Integration Dashboard</h2>
    <small class="text-muted">Total messages: <strong>@Model.Total</strong></small>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" asp-route-status="0" class="text-decoration-none">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.GetCount(0)</div>
                    <div class="small">NEW</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" asp-route-status="1" class="text-decoration-none">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.GetCount(1)</div>
                    <div class="small">PROCESSING</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" asp-route-status="2" class="text-decoration-none">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.GetCount(2)</div>
                    <div class="small">COMPLETED</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" asp-route-status="3" class="text-decoration-none">
            <div class="card bg-warning h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.GetCount(3)</div>
                    <div class="small">FAILED</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" asp-route-status="4" class="text-decoration-none">
            <div class="card text-white bg-danger h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.GetCount(4)</div>
                    <div class="small">DEAD</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-controller="MessageQueue" asp-action="Index" class="text-decoration-none">
            <div class="card text-white bg-dark h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold">@Model.Total</div>
                    <div class="small">ALL</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent Errors -->
@if (Model.RecentFailed.Any())
{
    <h5 class="mb-3">⚠️ Recent Errors (FAILED / DEAD)</h5>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle" id="errorsTable" style="table-layout:fixed;width:100%;">
            <colgroup>
                <col style="width:60px" />
                <col style="width:100px" />
                <col style="width:100px" />
                <col style="width:110px" />
                <col style="width:60px" />
                <col style="width:80px" />
                <col />
                <col />
                <col style="width:60px" />
            </colgroup>
            <thead class="table-dark">
                <tr>
                    <th class="resizable-th">ID<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Type<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Source<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Destination<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Env<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Status<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Payload<div class="th-resize-handle"></div></th>
                    <th class="resizable-th">Error<div class="th-resize-handle"></div></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var msg in Model.RecentFailed)
                {
                    <tr>
                        <td>@msg.Id</td>
                        <td><small>@msg.Type</small></td>
                        <td>@msg.SourceSystem</td>
                        <td>@msg.DestinationSystem</td>
                        <td><small>@msg.Environment</small></td>
                        <td><span class="@msg.StatusBadgeClass">@msg.StatusLabel</span></td>
                        <td>
                            <small class="text-muted text-truncate d-inline-block" style="max-width:200px;"
                                   title="@msg.Payload">@msg.Payload</small>
                        </td>
                        <td>
                            <small class="text-danger text-truncate d-inline-block" style="max-width:300px;"
                                   title="@msg.MessageLog">@msg.MessageLog</small>
                        </td>
                        <td>
                            <a asp-controller="MessageQueue" asp-action="Detail" asp-route-id="@msg.Id"
                               class="btn btn-sm btn-outline-secondary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-success">✅ No failed or dead messages.</div>
}

<style>
    .resizable-th {
        position: relative;
        overflow: visible;
    }
    .th-resize-handle {
        position: absolute;
        right: -4px;
        top: 0;
        bottom: 0;
        width: 8px;
        cursor: col-resize;
        z-index: 10;
        border-right: 2px solid transparent;
    }
    .th-resize-handle:hover,
    .th-resize-handle.active {
        border-right-color: rgba(255,255,255,0.6);
        background: rgba(255,255,255,0.15);
    }
    #errorsTable td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

@section Scripts {
<script>
(function () {
    var table = document.getElementById('errorsTable');
    if (!table) return;
    var cols = table.querySelectorAll('colgroup col');

    table.querySelectorAll('.th-resize-handle').forEach(function (handle, i) {
        var startX, startW, col, th;

        handle.addEventListener('mousedown', function (e) {
            th  = handle.parentElement;
            col = cols[i];
            startX = e.pageX;
            startW = th.getBoundingClientRect().width;
            handle.classList.add('active');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
            e.preventDefault();
        });

        function onMove(e) {
            var w = Math.max(40, startW + (e.pageX - startX));
            col.style.width = w + 'px';
        }

        function onUp() {
            handle.classList.remove('active');
            document.body.style.cursor = '';
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onMove);
            document.removeEventListener('mouseup', onUp);
        }
    });
})();
</script>
}
