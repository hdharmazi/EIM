// ── Build grouped dropdown ────────────────────────────────────────────────
(function buildDropdown() {
    const sel    = document.getElementById('scenarioPicker');
    const groups = {};
    for (const [id, s] of Object.entries(SCENARIOS)) {
        if (!groups[s.group]) groups[s.group] = [];
        groups[s.group].push({ id, label: s.label });
    }
    for (const [groupName, items] of Object.entries(groups)) {
        const og = document.createElement('optgroup');
        og.label = groupName;
        for (const item of items) {
            const opt       = document.createElement('option');
            opt.value       = item.id;
            opt.textContent = item.label;
            og.appendChild(opt);
        }
        sel.appendChild(og);
    }
})();

function onScenarioChange() {
    const id  = document.getElementById('scenarioPicker').value;
    const btn = document.getElementById('runBtn');
    const fc  = document.getElementById('fieldsContainer');

    if (!id) { fc.innerHTML = ''; btn.disabled = true; return; }

    const scenario = SCENARIOS[id];
    let html = '<div class="mb-2"><small class="text-muted fw-semibold">Payload Fields</small></div>';
    for (const field of scenario.fields) {
        const req = field.req ? ' <span class="text-danger">*</span>' : '';
        html += `
            <div class="mb-2">
                <label class="form-label form-label-sm mb-1">${field.l}${req}</label>
                <input type="text" class="form-control form-control-sm sim-field"
                       data-key="${field.k}" value="${field.d}"
                       ${field.req ? 'required' : ''} />
            </div>`;
    }
    fc.innerHTML = html;
    btn.disabled = false;
}

function collectFields() {
    const fields = {};
    document.querySelectorAll('.sim-field').forEach(el => {
        fields[el.dataset.key] = el.value;
    });
    return fields;
}

// ── Log helpers ───────────────────────────────────────────────────────────
const COLORS = {
    info:     '#9cdcfe',
    success:  '#4ec94e',
    warning:  '#dcdcaa',
    error:    '#f44747',
    payload:  '#ce9178',
    received: '#4fc1ff',
    done:     '#6a9955',
};

function appendLog(level, text) {
    const panel = document.getElementById('logContent');
    const div   = document.createElement('div');
    div.style.color        = COLORS[level] ?? '#d4d4d4';
    div.style.whiteSpace   = 'pre-wrap';
    div.style.wordBreak    = 'break-all';
    div.style.marginBottom = '2px';

    const prefix = level === 'success'  ? '\u2713 '
                 : level === 'error'    ? '\u2717 '
                 : level === 'warning'  ? '\u26a0 '
                 : level === 'payload'  ? '  \ud83d\udce4 '
                 : level === 'received' ? '  \ud83d\udce5 '
                 : '  ';

    if (level === 'payload' || level === 'received') {
        try {
            div.textContent = prefix + JSON.stringify(JSON.parse(text), null, 2);
        } catch {
            div.textContent = prefix + text;
        }
    } else {
        div.textContent = prefix + text;
    }

    panel.appendChild(div);
    document.getElementById('logPanel').scrollTop = document.getElementById('logPanel').scrollHeight;
}

function clearLog() {
    document.getElementById('logContent').innerHTML =
        '<span style="color:#6a9955">// Select a scenario and click Run Simulation</span>';
}

// ── Run simulation ────────────────────────────────────────────────────────
let _running = false;

async function runSimulation() {
    if (_running) return;

    const scenarioId = document.getElementById('scenarioPicker').value;
    if (!scenarioId) return;

    clearLog();
    appendLog('info', 'Starting: ' + SCENARIOS[scenarioId].label);
    appendLog('info', new Date().toISOString());

    _running = true;
    const btn = document.getElementById('runBtn');
    btn.disabled    = true;
    btn.textContent = '\u23f3 Running...';

    try {
        const response = await fetch('/Simulation/Run', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ scenario: scenarioId, fields: collectFields() })
        });

        if (!response.ok) {
            appendLog('error', 'HTTP ' + response.status + ': ' + await response.text());
            return;
        }

        const reader  = response.body.getReader();
        const decoder = new TextDecoder();
        let   buffer  = '';

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() ?? '';

            for (const line of lines) {
                if (!line.startsWith('data: ')) continue;
                try {
                    const evt = JSON.parse(line.slice(6));
                    appendLog(evt.level, evt.text);
                } catch { /* ignore malformed */ }
            }
        }
    } catch (err) {
        appendLog('error', 'Connection error: ' + err.message);
    } finally {
        _running        = false;
        btn.disabled    = false;
        btn.textContent = '\u25b6 Run Simulation';
    }
}
</script>
