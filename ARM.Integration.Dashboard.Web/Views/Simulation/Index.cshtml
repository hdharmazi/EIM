@{
    ViewData["Title"] = "Integration Simulation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Integration Simulation</h4>
    <small class="text-muted">Send test messages to Service Bus and watch results in real time</small>
</div>

<div class="row g-3">
    <!-- Left panel: scenario picker + fields -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Scenario</label>
                    <select id="scenarioPicker" class="form-select" onchange="onScenarioChange()">
                        <option value="">— select a scenario —</option>
                    </select>
                </div>
                <div id="fieldsContainer"></div>
                <button id="runBtn" class="btn btn-primary w-100 mt-3" onclick="runSimulation()" disabled>
                    &#9654; Run Simulation
                </button>
            </div>
        </div>
    </div>

    <!-- Right panel: live log -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold small">Output</span>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearLog()">Clear</button>
            </div>
            <div id="logPanel"
                 style="font-family:'Consolas','Courier New',monospace; font-size:0.82rem;
                        background:#1e1e1e; color:#d4d4d4; min-height:420px; max-height:600px;
                        overflow-y:auto; border-radius:0 0 0.375rem 0.375rem;">
                <div id="logContent" class="p-3">
                    <span style="color:#6a9955">// Select a scenario and click Run Simulation</span>
                </div>
            </div>
        </div>
    </div>
</div>

