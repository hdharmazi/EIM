# Copy to .env.local and fill in your Entra + API values.

# Entra ID (Azure AD) app registration for the SPA (public client)
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Scope exposed by the Dashboard API app registration
VITE_API_SCOPE=api://<dashboard-api-app-id>/access_as_user

# Optional: absolute API base URL. Leave empty to use same-origin (/api),
# which is proxied to the API by Vite in dev and by nginx in production.
VITE_API_BASE_URL=

# Dev only: where Vite proxies /api to (defaults to http://localhost:5060)
VITE_DEV_API_URL=http://localhost:5060
