# =============================================================================
# ARM.Integration.Wilson - package & deploy (Azure Container Apps version)
#
# Deploys everything into a single Container Apps environment:
#   1. dashboard-api      -> Container App (internal ingress)
#   2. dashboard-frontend -> Container App (external ingress, nginx + SPA)
#   3. eim-customer       -> Container App (Azure Functions, single instance / ordered)
#
# Prereqs: Azure CLI with the containerapp extension, and .NET 10 SDK.
#   az extension add --name containerapp --upgrade
#
# Images are built server-side with `az acr build`, so a local Docker daemon
# is NOT required.
# =============================================================================

# Login (skip if already logged in)
az login

# -----------------------------------------------------------------------------
# Variables — change these to match your subscription / environment
# -----------------------------------------------------------------------------
$RESOURCE_GROUP  = "d365fsc-integration-nonprod"
$LOCATION        = "centralus"
$ACR_NAME        = "wtcd365fscintegrationacrdev"           # must be globally unique, lowercase
$ACA_ENV         = "wtcd365fscintegrationcaedev"
$IMAGE_TAG       = "latest"                       # e.g. a build number for traceability
$STORAGE_ACCOUNT = "wtcd365fscintegrationdev"            # 3-24 lowercase alphanumeric, globally unique

# Secrets / config — FILL THESE IN before running (do not commit real values)
$EIMDB_CONNECTION_STRING   = "Data Source=tcp:azql-wtc-sandbox.database.windows.net,1433;Initial Catalog=eimdb;User ID=sadmin;Password=b3Y[7TBk;Pooling=False;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Authentication=SqlPassword;Connect Retry Count=1;Connect Retry Interval=10;Command Timeout=30"
$DASHBOARD_API_KEY         = "<YOUR_API_KEY-FUTUREPLACEHOLDER>"
$SERVICEBUS_CONNECTION     = "Endpoint=sb://asb-eim-wtc-nonprod.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=4gzdDB8HYmPSui549y8z+o+zHtFySmtM9+ASbLQswiw="

# Frontend Entra (Azure AD) settings — baked into the SPA at BUILD time
$VITE_ENTRA_TENANT_ID = "5e8a5341-629d-4421-9dbf-f5a5224ce6e7"
$VITE_ENTRA_CLIENT_ID = "317063cf-07c0-46ea-8a97-a92eaa7d807e"
$VITE_API_SCOPE       = "api://317063cf-07c0-46ea-8a97-a92eaa7d807e/access_as_user"        # e.g. api://<client-id>/access_as_user

# Image names (match docker-compose.yml)
$API_IMAGE  = "arm-integration-dashboard-api"
$WEB_IMAGE  = "arm-integration-dashboard-frontend"
$FUNC_IMAGE = "arm-integration-eim-customer"

# -----------------------------------------------------------------------------
# 1. Resource Group
# -----------------------------------------------------------------------------
az group create --name $RESOURCE_GROUP --location $LOCATION

# -----------------------------------------------------------------------------
# 2. Azure Container Registry
# -----------------------------------------------------------------------------
az acr create --name $ACR_NAME --resource-group $RESOURCE_GROUP --sku Basic --admin-enabled true

# -----------------------------------------------------------------------------
# 3. PACKAGE: build & push images in ACR (server-side, no local Docker needed)
# -----------------------------------------------------------------------------
# API — Dockerfile expects the repo root as build context.
az acr build `
  --registry $ACR_NAME `
  --image "${API_IMAGE}:$IMAGE_TAG" `
  --file ARM.Integration.Dashboard.API/Dockerfile `
  .

# Frontend — context is the frontend folder; Entra config is baked via build args.
az acr build `
  --registry $ACR_NAME `
  --image "${WEB_IMAGE}:$IMAGE_TAG" `
  --file ARM.Integration.Dashboard.Frontend/Dockerfile `
  --build-arg "VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID" `
  --build-arg "VITE_ENTRA_CLIENT_ID=$VITE_ENTRA_CLIENT_ID" `
  --build-arg "VITE_API_SCOPE=$VITE_API_SCOPE" `
  ARM.Integration.Dashboard.Frontend

# EIM.Customer function — Dockerfile expects the repo root as build context.
az acr build `
  --registry $ACR_NAME `
  --image "${FUNC_IMAGE}:$IMAGE_TAG" `
  --file ARM.Integration.EIM.Customer/Dockerfile `
  .

# ACR admin credentials for Container Apps to pull the images
$ACR_USER = az acr credential show -n $ACR_NAME --query "username" -o tsv
$ACR_PASS = az acr credential show -n $ACR_NAME --query "passwords[0].value" -o tsv

# -----------------------------------------------------------------------------
# 4. Container Apps Environment
# -----------------------------------------------------------------------------
az containerapp env create --name $ACA_ENV --resource-group $RESOURCE_GROUP --location $LOCATION

# -----------------------------------------------------------------------------
# 5. Deploy API container app (internal ingress — only reachable inside the env)
# -----------------------------------------------------------------------------
az containerapp create `
  --name dashboard-api `
  --resource-group $RESOURCE_GROUP `
  --environment $ACA_ENV `
  --image "$ACR_NAME.azurecr.io/${API_IMAGE}:$IMAGE_TAG" `
  --registry-server "$ACR_NAME.azurecr.io" `
  --registry-username $ACR_USER `
  --registry-password $ACR_PASS `
  --target-port 8080 `
  --ingress internal `
  --min-replicas 1 `
  --secrets `
    "eimdb-connstring=$EIMDB_CONNECTION_STRING" `
    "api-key=$DASHBOARD_API_KEY" `
    "simulation-sb-connection=$SERVICEBUS_CONNECTION" `
  --env-vars `
    "ASPNETCORE_ENVIRONMENT=Production" `
    "ASPNETCORE_HTTP_PORTS=8080" `
    "ConnectionStrings__EIMDB=secretref:eimdb-connstring" `
    "ApiKey=secretref:api-key" `
    "Simulation__ServiceBusConnectionString=secretref:simulation-sb-connection" `
    "Simulation__D365Queue=dev-d365fsc-dataevent" `
    "Simulation__CaptureToD365Queue=dev-capture-to-d365fsc" `
    "Simulation__CaptureToD365ResponseQueue=dev-capture-to-d365fsc-response" `
    "Simulation__D365ToCaptureQueue=dev-d365fsc-to-capture"

# Internal FQDN the frontend's nginx will reverse-proxy /api/ to
$API_FQDN = az containerapp show `
  --name dashboard-api `
  --resource-group $RESOURCE_GROUP `
  --query "properties.configuration.ingress.fqdn" -o tsv

# -----------------------------------------------------------------------------
# 6. Deploy Frontend container app (external ingress)
#    nginx proxies /api/ -> API_UPSTREAM (the internal API app).
# -----------------------------------------------------------------------------
az containerapp create `
  --name dashboard-frontend `
  --resource-group $RESOURCE_GROUP `
  --environment $ACA_ENV `
  --image "$ACR_NAME.azurecr.io/${WEB_IMAGE}:$IMAGE_TAG" `
  --registry-server "$ACR_NAME.azurecr.io" `
  --registry-username $ACR_USER `
  --registry-password $ACR_PASS `
  --target-port 8080 `
  --ingress external `
  --min-replicas 1 `
  --env-vars `
    "API_UPSTREAM=https://$API_FQDN"

$WEB_FQDN = az containerapp show `
  --name dashboard-frontend `
  --resource-group $RESOURCE_GROUP `
  --query "properties.configuration.ingress.fqdn" -o tsv
Write-Host "Dashboard is available at: https://$WEB_FQDN"

# -----------------------------------------------------------------------------
# 7. Deploy EIM.Customer as a Container App (Azure Functions worker)
#    - No ingress (Service Bus + Timer triggers only).
#    - Pinned to a SINGLE instance (min = max = 1) so queue messages are
#      processed strictly in order. dev-capture-to-d365fsc must be sequential
#      (e.g. customer insert -> add address -> add phone); parallel replicas
#      would break that ordering, so there is deliberately NO KEDA scale-out.
# -----------------------------------------------------------------------------
# Storage account required by the Functions runtime (timers, singleton locks)
az storage account create `
  --name $STORAGE_ACCOUNT `
  --resource-group $RESOURCE_GROUP `
  --location $LOCATION `
  --sku Standard_LRS
$STORAGE_CONN = az storage account show-connection-string `
  --name $STORAGE_ACCOUNT `
  --resource-group $RESOURCE_GROUP `
  --query connectionString -o tsv

az containerapp create `
  --name eim-customer `
  --resource-group $RESOURCE_GROUP `
  --environment $ACA_ENV `
  --image "$ACR_NAME.azurecr.io/${FUNC_IMAGE}:$IMAGE_TAG" `
  --registry-server "$ACR_NAME.azurecr.io" `
  --registry-username $ACR_USER `
  --registry-password $ACR_PASS `
  --ingress disabled `
  --min-replicas 1 `
  --max-replicas 1 `
  --secrets `
    "servicebus-connection=$SERVICEBUS_CONNECTION" `
    "eimdb-connstring=$EIMDB_CONNECTION_STRING" `
    "storage-connection=$STORAGE_CONN" `
  --env-vars `
    "AzureWebJobsStorage=secretref:storage-connection" `
    "FUNCTIONS_WORKER_RUNTIME=dotnet-isolated" `
    "ServiceBus=secretref:servicebus-connection" `
    "EIMDB=secretref:eimdb-connstring" `
    "D365DataEventQueue=dev-d365fsc-dataevent" `
    "D365BusinessEventQueue=dev-d365fsc-businessevents" `
    "D365ToCaptureQueue=dev-d365fsc-to-capture" `
    "CaptureToD365Queue=dev-capture-to-d365fsc" `
    "CaptureToD365QueueResponse=dev-capture-to-d365fsc-response" `
    "CaptureToD365QueueActive=True" `
    "PollSchedule=0 */1 * * * *" `
    "AwaitingD365SweepSchedule=0 */15 * * * *" `
    "AwaitingD365StuckTimeoutHours=4" `
    "DefaultEnvironment=dev" `
    "ExcludedUsers=51E452DB-CF29-4EDA-951C-50332FBB11AA;991452DB-CF29-4EDA-951C-50332FBB1322"